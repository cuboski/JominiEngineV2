<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Suppress obsolete-crypto warnings that originate from the legacy Lidgren
      handshake code in TestTextClient.cs (SHA256Managed, RNGCryptoServiceProvider,
      TripleDESCryptoServiceProvider).  These are warnings-only on .NET 8 and the
      code paths are either unused (crypto field) or in the #else / non-DEBUG block.
    -->
    <NoWarn>$(NoWarn);SYSLIB0021;SYSLIB0022;SYSLIB0023;SYSLIB0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Use the Lidgren.Network.dll that ships inside the Unity project (Assets/Plugins/).
      That build targets .NET Standard 2.0 / Mono and its socket layer works correctly
      on .NET 8, unlike the NuGet package "Lidgren.Network 1.0.2" which was compiled
      for .NET Framework 4.x and whose NetUtility.Resolve() throws
      PlatformNotSupportedException as a field initialiser before Connect() ever runs.

      To populate Libs/:
          cp <UnityProject>/Assets/Plugins/Lidgren.Network.dll JominiAIClient/Libs/
    -->
    <Reference Include="Lidgren.Network">
      <HintPath>Libs\Lidgren.Network.dll</HintPath>
    </Reference>

    <!--
      protobuf-net and ProtoMessageClient come from the game server's own build output
      so the exact type versions are guaranteed to match at runtime.
    -->
	  <Reference Include="protobuf-net">
		  <HintPath>..\..\server\ProtoMessageClient\bin\Debug\protobuf-net.dll</HintPath>
	  </Reference>
	  <Reference Include="protobuf-net.Core">
		  <HintPath>..\..\server\ProtoMessageClient\bin\Debug\protobuf-net.Core.dll</HintPath>
	  </Reference>
    <Reference Include="ProtoMessageClient">
      <HintPath>..\..\server\ProtoMessageClient\bin\Debug\ProtoMessageClient.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
